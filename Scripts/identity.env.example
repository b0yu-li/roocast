# Copy to Scripts/identity.env (gitignored) for local/release packaging.
# Official values live only on the maintainer machine — never commit identity.env.

# CFBundleIdentifier written into the .app Info.plist by release.sh / dev-install.sh
BUNDLE_ID=com.example.roocast

# Product-site URLs for Check for Updates (also written into Info.plist)
UPDATE_FEED_URL=https://example.com/roocast/latest.json
UPDATE_SITE_URL=https://example.com/

# Ed25519 public key (base64, 32 raw bytes). Derive from your private PEM:
#   openssl pkey -in update-ed25519-private.pem -pubout -outform DER | tail -c 32 | base64
# Private key stays in notary/ or .update-keys/ — never commit it.
UPDATE_PUBLIC_KEY_B64=

# Default DMG URL host used when signing the feed fragment in release.sh
# (full URL becomes ${UPDATE_DMG_BASE}/Roocast-$VERSION.dmg)
UPDATE_DMG_BASE=https://example.com/downloads
